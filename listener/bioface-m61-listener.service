[Unit]
Description=Realand BioFace M61 multi-protocol attendance listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<your-user>
Group=<your-user>
WorkingDirectory=/opt/bioface-m61-listener
ExecStart=/usr/bin/python3 /opt/bioface-m61-listener/listener.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/bioface-m61-listener.log
StandardError=append:/var/log/bioface-m61-listener.log

# Allow binding to privileged ports (80, 5005) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log /opt/bioface-m61-listener/data /tmp
# PrivateTmp is intentionally disabled — the command queue at
# /tmp/secureeye-cmd-queue.jsonl must be visible from outside the service.

[Install]
WantedBy=multi-user.target
